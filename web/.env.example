# ── PlumeRank web ────────────────────────────────────────────
# The only environment variable this app reads (web/lib/api.ts). It is inlined
# at BUILD time by Next.js, so it must be set before `npm run build` / `npm run dev`,
# not at container start.
#
# Local dev, against a FastAPI backend you started yourself:
#   (repo root) .venv/bin/uvicorn api.main:app --reload
NEXT_PUBLIC_PLUMERANK_API=http://127.0.0.1:8000

# Pointed at the live box instead:
# NEXT_PUBLIC_PLUMERANK_API=http://44.242.91.201

# PlumeRank -- the whole web tier. Installed to /etc/caddy/Caddyfile by deploy/bootstrap.sh.
#
# Both variables come from /etc/plumerank.env via the systemd drop-in bootstrap.sh writes.
# An empty PLUMERANK_DOMAIN falls back to :80, which is the correct first-boot state: the
# Elastic IP and the A record do not exist yet, so there is nothing Let's Encrypt could
# validate and an unconditional domain here would only produce a failing ACME loop.
# Setting the domain and re-running bootstrap.sh is what turns TLS on. Port 80 stays open
# afterwards because it carries the ACME challenge and the redirect Caddy installs on it.
# An EXPLICIT site block. A Caddyfile whose first line is a bare site address treats the
# rest of the file as that site implicitly -- but only when the address is a literal.
# With an env placeholder as the address, Caddy 2.8 parses the file as global scope and
# refuses the matcher: "request matchers may not be defined globally" (first launch,
# 2026-09-17). The braces cost nothing and remove the ambiguity.
#
# TWO addresses, one site. The second is the Elastic IP over plain HTTP, which every
# judge-facing document linked before the domain existed: with the domain alone, setting
# PLUMERANK_DOMAIN would silently retire that URL (Caddy's :80 then belongs to the domain's
# redirect, and an IP-addressed request matches no site). bootstrap.sh writes
# PLUMERANK_PUBLIC_IP from IMDS; the 127.0.0.1 default only keeps the address parseable.
{$PLUMERANK_DOMAIN::80}, http://{$PLUMERANK_PUBLIC_IP:127.0.0.1} {
	@backend path /api/* /health /build-info

	# Security headers on every response, static and proxied. The CSP fits the Next.js
	# static export as it is built: the export inlines its bootstrap and RSC payload as
	# <script> tags, so script-src needs 'unsafe-inline' (hashes would change on every
	# build); fonts are self-hosted under /_next and /fonts; the wall's EventSource and
	# /api/benchmark are same-origin, hence connect-src 'self'. frame-ancestors and
	# X-Frame-Options together refuse framing in old and new browsers alike.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# HSTS only over TLS. While the box serves plain HTTP on :80 (no domain yet) the header
	# would be ignored by browsers anyway; once a domain is set, Caddy terminates TLS and
	# this matcher fires. No includeSubDomains/preload: the domain is not ours to pin forever.
	@tls protocol https
	header @tls Strict-Transport-Security "max-age=31536000"

	# `route`, not three bare `handle` blocks: handle blocks are sorted by path-matcher
	# specificity rather than by the order they are written in, and a mis-sorted catch-all
	# would serve the static export where the API belongs. route evaluates in written order.
	route {
		reverse_proxy @backend 127.0.0.1:8000 {
			# The live wall is SSE. Caddy buffers a proxied response by default, which for a
			# stream means ticks arrive in clumps or never -- a wall that dies silently behind
			# the proxy while working perfectly against 127.0.0.1:8000 in an ssh session. -1
			# flushes on every write. Nothing compresses this route, for the same reason.
			flush_interval -1
		}

		# Evidence crops are files on disk and never pass through Python: one request per
		# thumbnail against a single-worker Uvicorn that is holding 62 warm background models
		# would put image serving in contention with the pipeline producing the images.
		handle_path /evidence/* {
			root * {$PLUMERANK_ROOT:/opt/plumerank}/web/evidence
			file_server
		}

		# /results/ and /judge/ -> the slashless page. try_files cannot see "/results/" as
		# results.html, and a judge pasting a URL with a trailing slash got a bare 404.
		# Exactly these two paths, to fixed targets: a pattern that echoed the request path
		# back into Location was an open redirect ("/%5Cevil.example/" -> "/\evil.example",
		# which browsers read as "//evil.example"). The query string is kept.
		@slash_query {
			path /results/ /judge/
			expression `{query} != ""`
		}
		redir @slash_query /{http.request.uri.path.0}?{query} 308
		@slash path /results/ /judge/
		redir @slash /{http.request.uri.path.0} 308

		# The Next.js static export. try_files covers both export shapes, so a trailingSlash
		# change in next.config cannot turn /results into a 404 on the box only.
		root * {$PLUMERANK_ROOT:/opt/plumerank}/web/out
		encode zstd gzip
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Unknown paths get the export's own designed 404 page (with the 404 status), not
	# Caddy's empty body. Only static misses reach here: the API's JSON 404s are responses
	# from the backend, not handler errors, and pass through untouched.
	handle_errors 404 {
		root * {$PLUMERANK_ROOT:/opt/plumerank}/web/out
		rewrite * /404.html
		file_server
	}
}
